# GEMINI_API_KEY: Required for future AI assistant phase (Phase 4).
# AI Studio injects this at runtime when enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ------------------------------------------------------------------
# Hostinger MySQL & Server Configuration (Shared Web)
# Template variable names only. Set real values on the server only.
# ------------------------------------------------------------------
DB_HOST=""
DB_PORT="3306"
DB_NAME=""
DB_USER=""
DB_PASSWORD=""
PORT="3000"
# Production always uses MySQL. Set APP_STORAGE=mysql for local integration testing.
APP_STORAGE=""
SESSION_SECRET=""

# Required only on first launch against an empty database.
OWNER_USERNAME=""
OWNER_DISPLAY_NAME=""
OWNER_EMAIL=""
OWNER_PASSWORD=""

# Optional for the local preview server only.
ADMIN_PASSCODE=""

